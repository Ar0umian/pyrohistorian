    "step_deg": 0.25
  },
  "time": {
    "first_year": 2000,
    "last_year": 2026,
    "overlap_start_year": 2012,
    "weeks_per_year": 52,
    "week_rule": "week = min(52, (day_of_year - 1) // 7 + 1)"
  },
  "units": {
    "metric": "detections_per_week"
  },
  "sensors": {
    "legacy": {
      "product": "modis",
      "name": "MODIS",
      "satellites": [
        "AQUA"
      ],
      "operating_start": "2002-07-04",
      "operating_end": null
    },
    "new": {
      "product": "viirs_snpp",
      "name": "VIIRS",
      "satellites": [],
      "operating_start": "2012-01-20",
      "operating_end": null
    }
  },
  "filters": {
    "keep_fire_types": [
      0
    ],
    "min_modis_confidence": 30,
    "viirs_confidence_keep": [
      "n",
      "nominal",
      "h",
      "high"
    ]
  },
  "coverage": {
    "legacy": {
      "start": "2002-07-04",
      "end": "2026-10-05"
    },
    "new": {
      "start": "2012-01-20",
      "end": "2026-10-05"
    }
  },
  "absent_means": "zero detections if the week is inside meta.coverage for that sensor, otherwise missing",
  "quality_codes": {
    "G": {
      "label": "Measured",
      "meaning": "new-sensor (VIIRS) count"
    },
    "U": {
      "label": "Converted",
      "meaning": "legacy-sensor (MODIS) count converted with uncertainty"
    },
    "B": {
      "label": "Missing",
      "meaning": "no valid value (week outside sensor coverage)"
    }
  },
  "alarm": {
    "states": [
      "Normal",
      "Elevated",
      "Alarm"
    ],
    "elevated_percentile": 90,
    "alarm_percentile": 97.5,
    "min_abs_weekly_count": 5,
    "hysteresis_weeks": 1,
    "critical_min_weeks": 2
  },
  "ui": {
    "state_colors": {
      "Normal": "grey",
      "Elevated": "amber",
      "Alarm": "red"
    },
    "uncertain_pattern": "hatched",
    "modes": [
      "legacy_only",
      "harmonized"
    ]
  },
  "validation_method": "leave_one_year_out",
