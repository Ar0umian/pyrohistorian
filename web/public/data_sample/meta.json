  "ui": { "state_colors": { "Normal": "grey", "Elevated": "amber", "Alarm": "red" }, "uncertain_pattern": "hatched",
          "modes": ["legacy_only", "harmonized"] },
  "validation_method": "leave_one_year_out",
  "conversion": [
    { "region_id": "region_1", "month": 7, "median": 3.6, "low": 2.9, "high": 4.4, "n_years": 8 },
    { "region_id": "region_1", "month": 8, "median": 3.6, "low": 2.9, "high": 4.4, "n_years": 8 },
    { "region_id": "region_1", "month": 9, "median": 3.6, "low": 2.9, "high": 4.4, "n_years": 8 }
  ],
